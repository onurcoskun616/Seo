# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI API - içerik üretim ajanları için
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1

# Uygulamaya giriş için paylaşılan şifre (basit koruma)
APP_PASSWORD=
# Cookie imzalamak için rastgele uzun bir metin
AUTH_SECRET=

# Yayınlanacak site bilgisi (SEO/JSON-LD içinde kullanılır)
SITE_NAME=Topkapı Okulları
SITE_URL=https://www.topkapiokullari.com

# Google Search Console entegrasyonu (opsiyonel, /performance sayfası için)
# Bir GCP servis hesabı oluşturup Search Console API'yi etkinleştirin,
# servis hesabı e-postasını Search Console mülkünüze "Tam" yetkiyle ekleyin.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GSC_SITE_URL=https://www.topkapiokullari.com/

# Zamanlanmış toplu üretim (cron) için gizli anahtar
CRON_SECRET=

# GEO Görünürlük Testi - Gemini (opsiyonel; OpenAI zaten yukarıdaki
# OPENAI_API_KEY ile kullanılır). Google AI Studio'dan alınır.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
